# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Env
.env
.env.local

# Runtime
*.json.lock
.last_sync.json

# GCP
*.json
.gcp-sa.json

# Node (frontend)
webapp/frontend/node_modules/
# O Docker recompila esses arquivos a partir de src/ em cada imagem.
webapp/frontend/dist/

# IDE
.vscode/
.idea/

# Superpowers
.superpowers/

# Claude Code — ignora os conteúdos diretos (.claude/*) mas NÃO o diretório
# em si; isso permite que negações abaixo funcionem (padrão com /* ≠ com /)
.claude/*
# Slash-skills do Spec Kit devem ser versionados para sobreviver a re-clone
!.claude/skills/

# Impeccable: binário do Linux é baixado pelo launcher sob demanda (o do Windows fica versionado)
.claude/skills/impeccable/scripts/bin/linux-x64/
!.impeccable/design.json
