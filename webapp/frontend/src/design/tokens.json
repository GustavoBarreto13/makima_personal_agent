    "dark": {
      "paper": "oklch(0.185 0.022 320)",
      "paper-2": "oklch(0.21 0.022 320)",
      "card": "oklch(0.238 0.022 320)",
      "card-2": "oklch(0.27 0.022 320)",
      "mist": "oklch(0.22 0.025 320)",
