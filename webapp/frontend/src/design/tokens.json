{
  "$description": "Fonte única dos tokens do Design System Makima. Formato inspirado no W3C Design Tokens. Nunca edite src/design/tokens.css à mão: rode `npm run tokens`.",
  "font": {
    "display": "'Hanken Grotesk', system-ui, sans-serif",
    "sans": "'DM Sans', system-ui, sans-serif",
    "mono": "'DM Mono', ui-monospace, monospace"
  },
  "accent": {
    "$description": "Acento = identidade do agente. h e c vêm de agents.ts (via [data-agent]). L muda por tema.",
    "default": {
      "h": "25",
      "c": "0.17"
    },
    "light": {
      "l": "0.52",
      "l-deep": "0.42",
      "l-bright": "0.69",
      "on": "#fff"
    },
    "dark": {
      "l": "0.72",
      "l-deep": "0.82",
      "l-bright": "0.8",
      "on": "oklch(0.2 0.04 var(--ds-accent-h))"
    }
  },
  "color": {
    "light": {
      "paper": "oklch(0.991 0.005 350)",
      "paper-2": "oklch(0.974 0.008 350)",
      "card": "oklch(1 0.001 350)",
      "card-2": "oklch(0.978 0.007 350)",
      "mist": "oklch(0.962 0.016 348)",
