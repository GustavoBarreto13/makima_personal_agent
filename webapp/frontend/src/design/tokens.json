      "success": "oklch(0.46 0.12 158)",
      "danger-tint": "oklch(0.5 0.2 22 / 0.13)",
      "warn-tint": "oklch(0.735 0.135 78 / 0.2)",
      "info-tint": "oklch(0.5 0.13 245 / 0.13)",
      "success-tint": "oklch(0.46 0.12 158 / 0.14)",
      "star": "oklch(0.78 0.15 82)",
      "star-deep": "oklch(0.52 0.12 70)",
      "star-empty": "oklch(0.88 0.01 350)",
