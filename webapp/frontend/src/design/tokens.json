  "radius": {
    "xs": "7px",
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "pill": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "22px",
    "6": "32px",
    "8": "48px"
  },
  "text": {
    "xs": "11px",
    "sm": "12.5px",
    "md": "14px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "28px",
    "display": "clamp(30px, 3.6vw, 44px)"
  },
  "motion": {
    "dur-1": "120ms",
    "dur-2": "180ms",
    "dur-3": "260ms",
    "dur-4": "400ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.3, 1)",
    "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "z": {
    "base": "0",
    "sticky": "10",
    "topbar": "20",
    "drawer": "40",
    "modal": "50",
    "popover": "70",
    "toast": "90",
    "palette": "100"
  },
  "width": {
    "prose": "680px",
    "content": "1120px",
    "wide": "1440px"
  },
  "blur": {
    "default": "18px",
    "soft": "10px"
  },
  "breakpoint": {
    "sm": 640,
    "md": 900,
    "lg": 1280
  },
  "icon": {
    "stroke": "1.75",
    "sm": "14px",
    "md": "16px",
    "lg": "20px"
  },
  "density": {
    "comfy": {
      "row-pad": "12px"
    },
    "compact": {
      "row-pad": "7px"
    }
  },
  "chart": {
    "$description": "Paleta categórica de 8 cores, validada por contraste (>= 3:1 contra o card) nos dois temas. Sequencial e divergente derivam do acento.",
    "light": [
      "oklch(0.55 0.17 262)",
      "oklch(0.58 0.15 160)",
      "oklch(0.62 0.16 52)",
      "oklch(0.56 0.2 12)",
      "oklch(0.55 0.17 310)",
      "oklch(0.58 0.12 200)",
      "oklch(0.6 0.13 100)",
      "oklch(0.5 0.03 260)"
    ],
    "dark": [
      "oklch(0.74 0.14 262)",
      "oklch(0.77 0.14 160)",
      "oklch(0.78 0.14 60)",
      "oklch(0.75 0.15 12)",
      "oklch(0.76 0.14 310)",
      "oklch(0.78 0.11 200)",
      "oklch(0.8 0.12 100)",
      "oklch(0.72 0.03 260)"
    ],
    "positive": {
      "light": "oklch(0.52 0.12 158)",
      "dark": "oklch(0.76 0.13 158)"
    },
    "negative": {
      "light": "oklch(0.55 0.2 22)",
      "dark": "oklch(0.72 0.17 22)"
    }
  }
}
