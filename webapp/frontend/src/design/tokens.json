      "success-tint": "oklch(0.76 0.13 158 / 0.18)",
      "star": "oklch(0.82 0.15 85)",
      "star-deep": "oklch(0.85 0.12 85)",
      "star-empty": "oklch(0.4 0.02 330)",
      "scrim": "oklch(0 0 0 / 0.55)",
      "glass-bg": "oklch(0.32 0.02 348 / 0.42)",
      "glass-border": "oklch(1 0 0 / 0.08)",
      "glass-hi": "oklch(1 0 0 / 0.06)",
      "glass-shadow": "0 10px 34px oklch(0 0 0 / 0.28)",
      "shadow-sm": "0 1px 2px oklch(0 0 0 / 0.3)",
      "shadow-md": "0 4px 16px oklch(0 0 0 / 0.4)",
      "shadow-lg": "0 14px 40px oklch(0 0 0 / 0.55)",
      "on-danger": "oklch(0.18 0.01 320)",
      "white": "#ffffff"
    }
