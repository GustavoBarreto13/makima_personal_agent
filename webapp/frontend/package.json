{
  "name": "makima-webapp",
  "private": true,
  "version": "0.61.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "npm run build:android && npx cap sync android",
    "preview": "vite preview",
    "test": "vitest run",
    "tokens": "node scripts/gen-tokens.mjs && node scripts/gen-design-md.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "lint:design": "node scripts/audit-design.mjs --only lint",
    "audit:design": "node scripts/audit-design.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.7.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.1",
    "remark-gfm": "^4.0.1",
    "timepicker-ui": "4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1"
  }
}
