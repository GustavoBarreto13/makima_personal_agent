# Variáveis do build do APP ANDROID (npm run build:android → vite build --mode android).
# O site NÃO usa este arquivo: lá a API é a mesma origem e a base fica vazia.
# No app, o dist/ roda do próprio aparelho (https://localhost), então as chamadas precisam
# do endereço absoluto do servidor (ver src/lib/api.ts). Não é segredo — pode ser versionado.
VITE_API_BASE_URL=https://makima.gusstavo42-vps.cloud

# Client ID do tipo "Aplicativo da Web" criado no Google Cloud (seção B da etapa 2). NÃO é segredo.
# É o mesmo valor que o servidor aceita em GOOGLE_MOBILE_CLIENT_IDS. Preencher após criar a credencial.
VITE_GOOGLE_WEB_CLIENT_ID=954746205334-q3o1ij9v3cg9mdp055pugme5d6oc03p2.apps.googleusercontent.com
